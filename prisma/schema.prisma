// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// Tabla de Usuarios
model User {
  id        String   @id @default(uuid())
  username  String   @unique
  email     String   @unique
  createdAt DateTime @default(now())
  
  // Relaciones: Un usuario puede tener muchas reseñas
  reviews   Review[]
}

// Tabla de Reseñas y Calificaciones (El "Diario")
model Review {
  id        String   @id @default(uuid())
  rating    Int      // 1 al 5 estrellas
  text      String?  @db.Text 
  albumId   String   // El ID que nos devuelve Apple
  createdAt DateTime @default(now())

  // Relación con el Usuario
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Índice para buscar rápido las reseñas de un disco
  @@index([albumId])
}
